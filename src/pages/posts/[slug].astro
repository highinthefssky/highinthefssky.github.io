---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import YouTubeBrandFeature from '../../components/YouTubeBrandFeature.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => {
    const related = posts
      .filter((p) => p.slug !== post.slug && !p.data.draft)
      .map((p) => ({
        post: p,
        score: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .filter((r) => r.score > 0)
      .sort(
        (a, b) =>
          b.score - a.score ||
          new Date(b.post.data.publishedAt).getTime() -
            new Date(a.post.data.publishedAt).getTime()
      )
      .slice(0, 3)
      .map((r) => r.post);

    return {
      params: { slug: post.slug },
      props: { post, relatedPosts: related },
    };
  });
}

const { post, relatedPosts } = Astro.props;
const { title, description, publishedAt, tags, image } = post.data;
const isYoutubeSource = tags.some((tag) => tag.toLowerCase() === 'youtube');
const { Content } = await post.render();
const pageUrl = new URL(`/posts/${post.slug}/`, Astro.site).href;
const postStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: new Date(publishedAt).toISOString(),
  dateModified: new Date(publishedAt).toISOString(),
  mainEntityOfPage: pageUrl,
  keywords: tags,
  image: image ? [image] : undefined,
  author: {
    '@type': 'Organization',
    name: 'High in the FlightSim Sky',
  },
  publisher: {
    '@type': 'Organization',
    name: 'High in the FlightSim Sky',
    url: new URL('/', Astro.site).href,
  },
};
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Posts',
      item: new URL('/posts/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: pageUrl,
    },
  ],
};

// Format date helper
function formatDate(date: Date): string {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    hour: 'numeric',
    minute: 'numeric',
  }).format(date);
}
---

<BaseLayout title={title} description={description} ogType="article" image={image} imageAlt={`${title} post cover image`} structuredData={[postStructuredData, breadcrumbStructuredData]}>
  <article class="post-page">
    <div class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt)}
        </time>
        {isYoutubeSource && <YouTubeBrandFeature className="brand-feature" />}
        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a href={`/posts#tag=${encodeURIComponent(tag)}`} class="tag">
                {tag}
              </a>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="post-content">
      <Content />
    </div>

    {relatedPosts.length > 0 && (
      <section class="related-section">
        <h2 class="related-heading">Related Posts</h2>
        <div class="related-grid">
          {relatedPosts.map((related) => (
            <PostCard post={related} />
          ))}
        </div>
      </section>
    )}

    <footer class="post-footer">
      <a href="/posts" class="back-link">← Back to all posts</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 1.25rem;
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-card);
    color: var(--text-heading);
  }

  .post-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-accent);
    padding-bottom: 1.25rem;
  }

  .post-title {
    font-size: 2.5rem;
    margin: 0 0 1rem;
    color: var(--text-heading);
    line-height: 1.2;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .brand-feature {
    margin-top: -0.05rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    text-decoration: none;
    border: 1px solid var(--border-accent);
    transition: all 0.25s ease;
  }

  .tag:hover {
    background: rgba(14, 165, 233, 0.1);
    color: var(--accent);
    border-color: var(--accent);
  }

  .post-content {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  /* Markdown content styling */
  :global(.post-content h2) {
    font-size: 1.875rem;
    margin: 1.5rem 0 0.5rem;
    color: var(--text-heading);
  }

  :global(.post-content h3) {
    font-size: 1.5rem;
    margin: 1.25rem 0 0.5rem;
    color: var(--text-heading);
  }

  :global(.post-content p) {
    margin-bottom: 1rem;
  }

  :global(.post-content ul),
  :global(.post-content ol) {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }

  :global(.post-content li) {
    margin-bottom: 0.5rem;
  }

  :global(.post-content blockquote) {
    border-left: 4px solid var(--accent);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--text-muted);
    font-style: italic;
    background: var(--tag-bg);
    border-radius: 0.5rem;
    padding: 1rem;
  }

  :global(.post-content code) {
    background: var(--tag-bg);
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: 'JetBrains Mono', 'Monaco', 'Menlo', 'Courier New', monospace;
    font-size: 0.9em;
    color: var(--accent);
  }

  :global(.post-content pre) {
    background: var(--bg-panel);
    color: var(--text-heading);
    padding: 1rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    margin: 1rem 0;
    border: 1px solid var(--border-accent);
  }

  :global(.post-content pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  :global(.post-content img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1rem 0;
  }

  :global(.post-content table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    color: var(--text-muted);
  }

  :global(.post-content th),
  :global(.post-content td) {
    border: 1px solid var(--border-subtle);
    padding: 0.75rem;
    text-align: left;
  }

  :global(.post-content th) {
    background: var(--tag-bg);
    font-weight: 600;
  }

  .related-section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-accent);
  }

  .related-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0 0 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .post-footer {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-accent);
    margin-top: 2rem;
  }

  .back-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .back-link:hover {
    color: var(--accent-hover);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .post-page {
      padding: 1.25rem;
    }

    .post-title {
      font-size: 1.875rem;
    }

    .post-content {
      font-size: 1rem;
    }
  }
</style>
