---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import YouTubeBrandFeature from '../components/YouTubeBrandFeature.astro';

const allPlaylists = await getCollection('playlists');
const allVideos = await getCollection('videos');

// Build a map of videoId -> video data for quick lookups
const videoMap = new Map(allVideos.map((v) => [v.data.videoId, v]));

// Enrich playlists with video count and resolved thumbnail
const playlists = allPlaylists.map((pl) => {
  const firstVideoId = pl.data.videos[0];
  const firstVideo = videoMap.get(firstVideoId);
  const thumb = pl.data.thumbnail || firstVideo?.data.thumbnail || '';
  const validCount = pl.data.videos.filter((id) => videoMap.has(id)).length;

  // Total duration
  let totalDuration = 0;
  pl.data.videos.forEach((id) => {
    const v = videoMap.get(id);
    if (v) totalDuration += v.data.duration;
  });

  // Find the newest video publish date in this playlist
  let newestDate = new Date(0);
  pl.data.videos.forEach((id) => {
    const v = videoMap.get(id);
    if (v && new Date(v.data.publishedAt) > newestDate) {
      newestDate = new Date(v.data.publishedAt);
    }
  });

  return {
    ...pl.data,
    thumbnail: thumb,
    videoCount: validCount,
    totalDuration,
    newestDate,
  };
}).sort((a, b) => b.newestDate.getTime() - a.newestDate.getTime());

function formatTotalDuration(seconds) {
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  if (hours > 0) return hours + 'h ' + minutes + 'm';
  return minutes + 'm';
}
---

<BaseLayout title="Playlists" description="Browse curated Microsoft Flight Simulator playlist series organized by aircraft, goals, and skill level so you can learn with a focused sequence of videos.">
  <div class="playlists-page">
    <div class="playlists-header">
      <h1>Playlists</h1>
      <p>Curated video series to watch in order</p>
      <YouTubeBrandFeature className="brand-feature" size="lg" />
    </div>

    {playlists.length === 0 && (
      <div class="empty-state">
        <p>No playlists yet. Check back soon!</p>
      </div>
    )}

    <div class="playlists-grid">
      {playlists.map((pl) => (
        <a href={'/playlists/' + pl.slug} class="playlist-card">
          <div class="card-thumb">
            {pl.thumbnail && (
              <img src={pl.thumbnail} alt={pl.title} loading="lazy" decoding="async" />
            )}
            <div class="card-count-badge">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z" />
              </svg>
              {pl.videoCount} videos
            </div>
          </div>
          <div class="card-body">
            <h2 class="card-title">{pl.title}</h2>
            <p class="card-desc">{pl.description}</p>
            <div class="card-meta">
              <span class="card-duration">{formatTotalDuration(pl.totalDuration)}</span>
              <span class="card-cta">View playlist &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .playlists-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem 3rem;
  }

  .playlists-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .playlists-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
  }

  .playlists-header p {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .brand-feature {
    margin-top: 0.65rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
    font-size: 1.125rem;
  }

  .playlists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .playlist-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 0.75rem;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
    box-shadow: var(--shadow-card);
  }

  .playlist-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    border-color: var(--accent);
  }

  .card-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
  }

  .card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .playlist-card:hover .card-thumb img {
    transform: scale(1.05);
  }

  .card-source-brand {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 2;
  }

  .card-count-badge {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    padding: 0.3rem 0.65rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .card-body {
    padding: 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--text-heading);
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.5;
    flex: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
  }

  .card-duration {
    color: var(--text-muted);
  }

  .card-cta {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .playlists-grid {
      grid-template-columns: 1fr;
    }

    .playlists-header h1 {
      font-size: 2rem;
    }
  }
</style>
