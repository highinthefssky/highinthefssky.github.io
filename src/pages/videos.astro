---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import YouTubeBrandFeature from '../components/YouTubeBrandFeature.astro';
import stats from '../content/stats.json';

const allVideos = await getCollection('videos');
const totalVideos = stats.totalVideos ?? allVideos.length;
const sortedVideos = allVideos.sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
);

const allTags = Array.from(
  new Set(allVideos.flatMap((video) => video.data.tags))
).sort();

// Use the latest video thumbnail as OG image
const latestThumbnail = sortedVideos[0]?.data.thumbnail;
---

<BaseLayout title="Video Library" description="Browse and search the full Microsoft Flight Simulator video library with tag filters, keyboard shortcuts, and regularly updated tutorials and flight content." image={latestThumbnail} imageAlt="Video Library featured thumbnail">
  <div class="videos-page">
    <div class="videos-header">
      <h1>Video Library</h1>
      <p>
        Explore {totalVideos} videos from the channel
      </p>
      <YouTubeBrandFeature className="brand-feature" size="lg" />
    </div>

    <div class="search-controls">
      <div class="search-box">
        <input
          type="text"
          id="search-input"
          placeholder="Search videos (e.g. title:landing, description:IFR, navigation tutorial)"
          class="search-input"
          autocomplete="off"
        />
        <kbd class="search-kbd-hint" title="Press / to focus">/</kbd>
        <span class="search-icon">🔍</span>
      </div>

      <div class="filter-section">
        <div class="filter-header">
          <h3>Filter by Tags</h3>
          <button id="toggle-tags" class="toggle-btn" type="button">▼</button>
        </div>
        <div class="tag-filter-container" id="tag-container" style="display: none;">
          <input
            type="text"
            id="tag-search"
            placeholder="Search tags..."
            class="tag-search-input"
            autocomplete="off"
          />
          <div class="tags-list" id="tags-list">
            {allTags.map((tag) => (
              <button
                class="tag-filter"
                data-tag={tag}
                type="button"
              >
                {tag}
              </button>
            ))}
          </div>
          <div class="selected-tags" id="selected-tags"></div>
        </div>
      </div>

      <div class="controls-footer">
        <span id="result-count" class="result-count" data-total-videos={totalVideos}>
          {totalVideos} videos
        </span>
        <button id="clear-btn" class="btn-clear" type="button">
          Clear all filters
        </button>
      </div>
    </div>

    <div class="search-results">
      <div class="videos-grid" id="videos-grid">
        {sortedVideos.map((video) => (
          <VideoCard video={video} showBrandFeature={false} />
        ))}
      </div>

      <div class="load-more-container" id="load-more-container">
        <button id="load-more-btn" class="btn-load-more" type="button">
          Load more videos
        </button>
      </div>

      <div class="empty-state" id="empty-state" style="display: none;">
        <p>No videos found matching your search.</p>
        <button id="reset-btn" class="btn-reset">Reset search</button>
      </div>
    </div>
  </div>
  <KeyboardShortcuts shortcuts={[
    { key: '/', label: 'Focus search' },
    { key: 'Esc', label: 'Clear all filters' },
    { key: 't', label: 'Toggle tag filters' },
  ]} />
</BaseLayout>

<style>
  .videos-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .videos-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .videos-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
  }

  .videos-header p {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .brand-feature {
    margin-top: 0.65rem;
  }

  .search-controls {
    background: var(--bg-panel);
    padding: 2rem;
    border-radius: 0.75rem;
    margin-bottom: 2rem;
    border: 1px solid var(--border-default);
  }

  .search-box {
    position: relative;
    margin-bottom: 2rem;
  }

  .search-input {
    width: 100%;
    padding: 1rem;
    padding-right: 2.5rem;
    font-size: 1rem;
    border: 2px solid var(--border-input);
    border-radius: 0.5rem;
    background: var(--bg-input);
    color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
  }

  .search-input::placeholder {
    color: var(--text-input-placeholder);
  }

  .search-icon {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
  }

  .search-kbd-hint {
    position: absolute;
    right: 2.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    border-radius: 0.25rem;
    background: var(--bg-surface);
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .search-input:focus ~ .search-kbd-hint {
    opacity: 0;
  }

  .filter-section {
    margin-bottom: 1.5rem;
  }

  .filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .filter-section h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0;
  }

  .toggle-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.3s ease;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toggle-btn.open {
    transform: rotate(180deg);
  }

  .tag-filter-container {
    background: var(--bg-input);
    border: 1px solid var(--border-input);
    border-radius: 0.5rem;
    padding: 1rem;
    max-height: 400px;
    overflow-y: auto;
  }

  .tag-search-input {
    width: 100%;
    padding: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    border: 1px solid var(--border-input);
    border-radius: 0.375rem;
    background: var(--bg-panel);
    color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .tag-search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
  }

  .tag-search-input::placeholder {
    color: var(--text-input-placeholder);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .tag-filter {
    background: var(--bg-panel);
    border: 1px solid var(--border-input);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .tag-filter:hover {
    border-color: var(--accent);
    background: var(--bg-input);
    color: var(--text-heading);
  }

  .tag-filter.active {
    background: hsl(213, 94%, 47%);
    border-color: hsl(213, 94%, 47%);
    color: white;
  }

  .selected-tags {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-input);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 1rem;
  }

  .selected-tags .tag-filter {
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
  }

  .controls-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-default);
  }

  .result-count {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .btn-clear {
    background: transparent;
    border: 1px solid var(--border-input);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-clear:hover {
    background: var(--bg-input);
    border-color: var(--accent);
    color: var(--text-heading);
  }

  .btn-clear:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .search-results {
    min-height: 400px;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .load-more-container {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .btn-load-more {
    background: var(--bg-surface);
    color: var(--accent);
    border: 2px solid var(--accent);
    padding: 0.75rem 2.5rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .btn-load-more:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }

  .empty-state p {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
  }

  .btn-reset {
    background: hsl(213, 94%, 47%);
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-reset:hover {
    background: hsl(213, 94%, 37%);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .videos-page {
      padding: 1rem;
    }

    .videos-header h1 {
      font-size: 2rem;
    }

    .search-controls {
      padding: 1.5rem;
    }

    .controls-footer {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .videos-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
    }
  }
</style>
<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const tagSearchInput = document.getElementById('tag-search') as HTMLInputElement;
  const toggleBtn = document.getElementById('toggle-tags') as HTMLButtonElement;
  const tagContainer = document.getElementById('tag-container') as HTMLDivElement;
  const tagButtons = document.querySelectorAll('.tag-filter');
  const videosGrid = document.getElementById('videos-grid');
  const emptyState = document.getElementById('empty-state');
  const videoCards = document.querySelectorAll('[data-tags]');
  const resultCount = document.getElementById('result-count');
  const clearBtn = document.getElementById('clear-btn');
  const resetBtn = document.getElementById('reset-btn');
  const selectedTagsContainer = document.getElementById('selected-tags') as HTMLDivElement;
  const loadMoreBtn = document.getElementById('load-more-btn') as HTMLButtonElement;
  const loadMoreContainer = document.getElementById('load-more-container') as HTMLDivElement;
  const totalVideos = Number(resultCount?.getAttribute('data-total-videos') || '0');

  const PAGE_SIZE = 24;
  let visibleLimit = PAGE_SIZE;
  let activeTags = new Set<string>();

  function getInitialTagFromUrl(): string {
    const params = new URLSearchParams(window.location.search);
    const queryTag = params.get('tag')?.trim();
    if (queryTag) return queryTag;

    if (window.location.hash.startsWith('#tag=')) {
      const hashTag = window.location.hash.slice('#tag='.length).trim();
      if (hashTag) return decodeURIComponent(hashTag);
    }

    return '';
  }

  // Toggle tag filter visibility
  toggleBtn?.addEventListener('click', () => {
    const isOpen = tagContainer.style.display !== 'none';
    tagContainer.style.display = isOpen ? 'none' : 'block';
    toggleBtn.classList.toggle('open');
  });

  function normalizeString(str: string): string {
    return str.toLowerCase().trim();
  }

  function parseSearchQuery(raw: string): { term: string; field: 'all' | 'title' | 'description' } {
    const trimmed = raw.trim();
    if (!trimmed) return { term: '', field: 'all' };
    const lower = trimmed.toLowerCase();
    if (lower.startsWith('title:')) {
      return { term: trimmed.slice('title:'.length).trim(), field: 'title' };
    }
    if (lower.startsWith('description:')) {
      return { term: trimmed.slice('description:'.length).trim(), field: 'description' };
    }
    return { term: trimmed, field: 'all' };
  }

  function updateSelectedTagsDisplay() {
    selectedTagsContainer.innerHTML = '';
    activeTags.forEach((tag) => {
      const tagBtn = document.createElement('button');
      tagBtn.className = 'tag-filter active';
      tagBtn.textContent = `${tag} ✕`;
      tagBtn.type = 'button';
      tagBtn.addEventListener('click', () => {
        activeTags.delete(tag);
        document.querySelector(`[data-tag="${tag}"]`)?.classList.remove('active');
        updateSelectedTagsDisplay();
        updateDisplay();
      });
      selectedTagsContainer.appendChild(tagBtn);
    });
  }

  function updateDisplay() {
    const { term, field } = parseSearchQuery(searchInput.value || '');
    const searchTerm = normalizeString(term);
    const hasFilters = activeTags.size > 0 || !!searchInput.value.trim();

    // First pass: determine which cards match the current filters
    const matchingCards: HTMLElement[] = [];
    videoCards.forEach((card) => {
      const cardEl = card as HTMLElement;
      const tags = (cardEl.getAttribute('data-tags') || '')
        .split(',')
        .filter((t) => t)
        .map(normalizeString);
      const title = normalizeString(cardEl.querySelector('.card-title')?.textContent || '');
      const description = normalizeString(cardEl.querySelector('.card-content')?.textContent || '');

      const matchesSearch =
        !searchTerm ||
        (field === 'title' && title.includes(searchTerm)) ||
        (field === 'description' && description.includes(searchTerm)) ||
        (field === 'all' && (title.includes(searchTerm) || description.includes(searchTerm)));

      const matchesTags =
        activeTags.size === 0 ||
        Array.from(activeTags).some((tag) => tags.includes(normalizeString(tag)));

      if (matchesSearch && matchesTags) {
        matchingCards.push(cardEl);
      }
    });

    const totalMatching = hasFilters ? matchingCards.length : totalVideos;

    // Second pass: show matching cards up to visibleLimit, hide the rest
    let shown = 0;
    videoCards.forEach((card) => {
      const cardEl = card as HTMLElement;
      const isMatch = matchingCards.includes(cardEl);
      if (isMatch && shown < visibleLimit) {
        cardEl.style.display = '';
        shown++;
      } else {
        cardEl.style.display = 'none';
      }
    });

    resultCount!.textContent = `${totalMatching} ${totalMatching === 1 ? 'video' : 'videos'}`;
    emptyState!.style.display = totalMatching === 0 ? 'block' : 'none';
    videosGrid!.style.display = totalMatching === 0 ? 'none' : 'grid';
    clearBtn!.disabled = !hasFilters;

    // Show/hide Load More button
    const allShown = shown >= matchingCards.length;
    loadMoreContainer.style.display = allShown || totalMatching === 0 ? 'none' : 'flex';
    if (!allShown) {
      const remaining = matchingCards.length - shown;
      loadMoreBtn.textContent = `Load more videos (${remaining} remaining)`;
    }
  }

  // Tag search filter
  tagSearchInput?.addEventListener('input', (e) => {
    const searchTerm = normalizeString((e.target as HTMLInputElement).value);
    tagButtons.forEach((btn) => {
      const tagText = normalizeString(btn.getAttribute('data-tag') || '');
      btn.style.display = !searchTerm || tagText.includes(searchTerm) ? '' : 'none';
    });
  });

  // Load more button
  loadMoreBtn?.addEventListener('click', () => {
    visibleLimit += PAGE_SIZE;
    updateDisplay();
  });

  searchInput?.addEventListener('input', () => {
    visibleLimit = PAGE_SIZE;
    updateDisplay();
  });

  // Allow Enter to trigger search without submitting anything
  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      updateDisplay();
    }
  });

  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');
      if (tag) {
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          button.classList.remove('active');
        } else {
          activeTags.add(tag);
          button.classList.add('active');
        }
        updateSelectedTagsDisplay();
        visibleLimit = PAGE_SIZE;
        updateDisplay();
      }
    });
  });

  clearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    tagSearchInput.value = '';
    activeTags.clear();
    tagButtons.forEach((btn) => {
      btn.classList.remove('active');
      btn.style.display = '';
    });
    updateSelectedTagsDisplay();
    visibleLimit = PAGE_SIZE;
    updateDisplay();
  });

  resetBtn?.addEventListener('click', () => {
    searchInput.value = '';
    tagSearchInput.value = '';
    activeTags.clear();
    tagButtons.forEach((btn) => {
      btn.classList.remove('active');
      btn.style.display = '';
    });
    updateSelectedTagsDisplay();
    visibleLimit = PAGE_SIZE;
    updateDisplay();
  });

  // ── Keyboard shortcuts ──
  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') {
      // Escape while inside an input: blur and clear
      if (e.key === 'Escape') {
        (e.target as HTMLElement).blur();
      }
      return;
    }

    // Don't fire shortcuts when the help overlay is open
    if (document.getElementById('kbd-help')?.classList.contains('open')) return;

    if (e.key === '/') {
      e.preventDefault();
      searchInput?.focus();
    } else if (e.key === 'Escape') {
      e.preventDefault();
      searchInput.value = '';
      tagSearchInput.value = '';
      activeTags.clear();
      tagButtons.forEach((btn) => {
        btn.classList.remove('active');
        btn.style.display = '';
      });
      updateSelectedTagsDisplay();
      visibleLimit = PAGE_SIZE;
      updateDisplay();
    } else if (e.key === 't') {
      e.preventDefault();
      toggleBtn?.click();
    }
  });

  // Initialize
  const initialTag = getInitialTagFromUrl();
  if (initialTag) {
    const matchingTagButton = Array.from(tagButtons).find((button) =>
      normalizeString(button.getAttribute('data-tag') || '') ===
      normalizeString(initialTag)
    ) as HTMLElement | undefined;

    if (matchingTagButton) {
      const canonicalTag = matchingTagButton.getAttribute('data-tag') || initialTag;
      activeTags.add(canonicalTag);
      matchingTagButton.classList.add('active');
      tagContainer.style.display = 'block';
      toggleBtn?.classList.add('open');
      history.replaceState(
        null,
        '',
        `${window.location.pathname}#tag=${encodeURIComponent(canonicalTag)}`
      );
    }
  }

  updateSelectedTagsDisplay();
  updateDisplay();
</script>
