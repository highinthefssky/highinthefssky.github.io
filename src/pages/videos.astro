---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoCard from '../components/VideoCard.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import YouTubeBrandFeature from '../components/YouTubeBrandFeature.astro';
import VideoPagination from '../components/VideoPagination.astro';
import { VIDEO_PAGE_SIZE } from '../utils/videoPagination';

const allVideos = await getCollection('videos');
const totalVideos = allVideos.length;
const sortedVideos = allVideos.sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
);

const totalPages = Math.ceil(totalVideos / VIDEO_PAGE_SIZE);

// Use the latest video thumbnail as OG image
const latestThumbnail = sortedVideos[0]?.data.thumbnail;
---

<BaseLayout title="Video Library" description="Browse and search the full Microsoft Flight Simulator video library with tag filters, keyboard shortcuts, and regularly updated tutorials and flight content." image={latestThumbnail} imageAlt="Video Library featured thumbnail">
  <div class="videos-page">
    <div class="videos-header">
      <h1>Video Library</h1>
      <p>
        Explore {totalVideos} videos from the channel
      </p>
      <YouTubeBrandFeature className="brand-feature" size="lg" />
    </div>

    <div class="search-controls" hidden>
      <div class="search-box">
        <label class="search-label" for="search-input">Search videos</label>
        <div class="search-input-wrap">
          <input
            type="text"
            id="search-input"
            placeholder="Search videos (e.g. title:landing, description:IFR, navigation tutorial)"
            class="search-input"
            autocomplete="off"
          />
          <kbd class="search-kbd-hint" title="Press / to focus">/</kbd>
          <span class="search-icon" aria-hidden="true">🔍</span>
        </div>
      </div>

      <div class="filter-section">
        <div class="filter-header">
          <h3>Filter by Tags</h3>
          <button id="toggle-tags" class="toggle-btn" type="button" aria-label="Filter by tags" aria-controls="tag-container" aria-expanded="false">▼</button>
        </div>
        <div class="tag-filter-container" id="tag-container" style="display: none;">
          <label class="search-label" for="tag-search">Search video tags</label>
          <input
            type="text"
            id="tag-search"
            placeholder="Search tags..."
            class="tag-search-input"
            autocomplete="off"
          />
          <div class="tags-list" id="tags-list"></div>
          <p id="tag-status" role="status"></p>
          <template id="tag-template"><button class="tag-filter" type="button" aria-pressed="false"></button></template>
        </div>
        <div class="selected-tags" id="selected-tags"></div>
      </div>

      <div class="controls-footer">
        <span id="result-count" class="result-count" data-total-videos={totalVideos} role="status" aria-atomic="true">
          {totalVideos} videos
        </span>
        <button id="clear-btn" class="btn-clear" type="button">
          Clear all filters
        </button>
      </div>
    </div>

    <div class="search-results">
      <div id="search-error" role="alert" hidden>
        <p>Search is unavailable. Please retry or browse the video pages.</p>
        <button id="retry-search" type="button" class="btn-reset">Retry search</button>
      </div>
      <div class="videos-grid" id="videos-grid" tabindex="-1" aria-label="Video results" aria-busy="false">
        {sortedVideos.slice(0, VIDEO_PAGE_SIZE).map((video) => (
          <VideoCard video={video} showBrandFeature={false} />
        ))}
      </div>

      <div id="archive-pagination"><VideoPagination page={1} totalPages={totalPages} /></div>
      <div class="load-more-container" id="load-more-container" style="display: none;" role="group" aria-label="Search result pages">
        <button id="search-previous" class="btn-load-more" type="button">Previous results</button>
        <span id="search-page"></span>
        <button id="load-more-btn" class="btn-load-more" type="button">
          Next results
        </button>
      </div>

      <div class="empty-state" id="empty-state" style="display: none;">
        <p>No videos found matching your search.</p>
        <button id="reset-btn" class="btn-reset">Reset search</button>
      </div>
    </div>
  </div>
  <KeyboardShortcuts shortcuts={[
    { key: '/', label: 'Focus search' },
    { key: 'Esc', label: 'Clear all filters' },
    { key: 't', label: 'Toggle tag filters' },
  ]} />

<style>
  .videos-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .videos-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .videos-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
  }

  .videos-header p {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .brand-feature {
    margin-top: 0.65rem;
  }

  .search-controls {
    background: var(--bg-panel);
    padding: 2rem;
    border-radius: 0.75rem;
    margin-bottom: 2rem;
    border: 1px solid var(--border-default);
  }

  .search-box {
    margin-bottom: 2rem;
  }

  .search-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
    font-weight: 600;
  }

  .search-input-wrap {
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 1rem;
    padding-right: 2.5rem;
    font-size: 1rem;
    border: 2px solid var(--border-input);
    border-radius: 0.5rem;
    background: var(--bg-input);
    color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
  }

  .search-input::placeholder {
    color: var(--text-input-placeholder);
  }

  .search-icon {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
  }

  .search-kbd-hint {
    position: absolute;
    right: 2.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    border-radius: 0.25rem;
    background: var(--bg-surface);
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .search-input:focus ~ .search-kbd-hint {
    opacity: 0;
  }

  .filter-section {
    margin-bottom: 1.5rem;
  }

  .filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .filter-section h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0;
  }

  .toggle-btn {
    background: none;
    border: none;
    color: var(--accent);
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.3s ease;
    padding: 0;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .toggle-btn.open {
    transform: rotate(180deg);
  }

  .tag-filter-container {
    background: var(--bg-input);
    border: 1px solid var(--border-input);
    border-radius: 0.5rem;
    padding: 1rem;
    max-height: 400px;
    overflow-y: auto;
  }

  .tag-search-input {
    width: 100%;
    padding: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.95rem;
    border: 1px solid var(--border-input);
    border-radius: 0.375rem;
    background: var(--bg-panel);
    color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .tag-search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
  }

  .tag-search-input::placeholder {
    color: var(--text-input-placeholder);
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .tag-filter {
    background: var(--bg-panel);
    border: 1px solid var(--border-input);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .tag-filter:hover {
    border-color: var(--accent);
    background: var(--bg-input);
    color: var(--text-heading);
  }

  .tag-filter.active {
    background: hsl(213, 94%, 47%);
    border-color: hsl(213, 94%, 47%);
    color: white;
  }

  .selected-tags {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-input);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 1rem;
  }

  .selected-tags:empty { display: none; }

  .selected-tags .tag-filter {
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
  }

  .controls-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-default);
  }

  .result-count {
    font-size: 0.95rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .btn-clear {
    background: transparent;
    border: 1px solid var(--border-input);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: 0.375rem;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-clear:hover {
    background: var(--bg-input);
    border-color: var(--accent);
    color: var(--text-heading);
  }

  .btn-clear:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .search-results {
    min-height: 400px;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .load-more-container {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .btn-load-more {
    background: var(--bg-surface);
    color: var(--accent);
    border: 2px solid var(--accent);
    padding: 0.75rem 2.5rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .btn-load-more:hover {
    background: var(--accent);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
  }

  .btn-load-more:disabled { opacity: 0.5; cursor: not-allowed; }
  #videos-grid { scroll-margin-top: 6rem; }
  #search-error { margin-bottom: 1.5rem; }
  #tag-status { color: var(--text-muted); margin-top: 0.75rem; }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }

  .empty-state p {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
  }

  .btn-reset {
    background: hsl(213, 94%, 47%);
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-reset:hover {
    background: hsl(213, 94%, 37%);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .videos-page {
      padding: 1rem;
    }

    .videos-header h1 {
      font-size: 2rem;
    }

    .search-controls {
      padding: 1.5rem;
    }

    .controls-footer {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .videos-grid {
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 1rem;
    }
  }
</style>
<script>
  import '../scripts/videoArchive';
</script>
</BaseLayout>
