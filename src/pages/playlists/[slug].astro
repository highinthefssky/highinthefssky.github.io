---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YouTubeBrandFeature from '../../components/YouTubeBrandFeature.astro';

export async function getStaticPaths() {
  const playlists = await getCollection('playlists');
  const allVideos = await getCollection('videos');
  const videoMap = new Map(allVideos.map((v) => [v.data.videoId, v]));
  type VideoEntry = CollectionEntry<'videos'>;

  return playlists.map((pl) => {
    const resolvedVideos = pl.data.videos
      .map((id) => videoMap.get(id))
      .filter((video): video is VideoEntry => Boolean(video));

    return {
      params: { slug: pl.data.slug },
      props: { playlist: pl.data, videos: resolvedVideos },
    };
  });
}

const { playlist, videos } = Astro.props;

function formatDuration(seconds: number): string {
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const secs = seconds % 60;
  if (hours > 0) {
    return hours + ':' + String(minutes).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
  }
  return minutes + ':' + String(secs).padStart(2, '0');
}

const firstVideo = videos[0];
const metaDescription = playlist.description.slice(0, 160);
const ogImage = playlist.thumbnail || firstVideo?.data.thumbnail || '';
const pageUrl = new URL(`/playlists/${playlist.slug}/`, Astro.site).href;
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Playlists',
      item: new URL('/playlists/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: playlist.title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout title={playlist.title + ' — Playlist'} description={metaDescription} image={ogImage} imageAlt={`${playlist.title} playlist cover image`} structuredData={breadcrumbStructuredData}>
  <div class="playlist-page">
    <!-- Mobile header -->
    <div class="playlist-mobile-header">
      <a href="/playlists" class="back-link">&larr; All playlists</a>
      <h1>{playlist.title}</h1>
      <p class="playlist-desc">{playlist.description}</p>
      <button class="sidebar-toggle" id="sidebar-toggle" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z" />
        </svg>
        <span id="sidebar-toggle-text">Show playlist ({videos.length})</span>
      </button>
    </div>

    <div class="playlist-layout">
      <!-- Main player area -->
      <main class="player-area">
        <div class="player-wrapper">
          <iframe
            id="playlist-player"
            src={firstVideo ? 'https://www.youtube-nocookie.com/embed/' + firstVideo.data.videoId : ''}
            title={firstVideo?.data.title || 'Video player'}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
            class="player-iframe"
          ></iframe>
        </div>

        <div class="now-playing">
          <div class="now-playing-info">
            <h2 id="now-playing-title">{firstVideo?.data.title || 'No videos'}</h2>
            <div class="now-playing-meta">
              <span id="now-playing-index">1 / {videos.length}</span>
              <span class="meta-sep">&middot;</span>
              <YouTubeBrandFeature className="brand-feature" />
              <a
                id="now-playing-yt-link"
                href={firstVideo ? 'https://www.youtube.com/watch?v=' + firstVideo.data.videoId : '#'}
                target="_blank"
                rel="noopener noreferrer"
                class="yt-link"
              >
                Watch on YouTube
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            </div>
          </div>

          <div class="player-nav">
            <button id="prev-btn" class="nav-btn" disabled title="Previous video" type="button">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M6 6h2v12H6V6zm3.5 6 8.5 6V6l-8.5 6z" /></svg>
              Prev
            </button>
            <button id="next-btn" class="nav-btn" title="Next video" type="button">
              Next
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M16 6h2v12h-2V6zM6 18l8.5-6L6 6v12z" /></svg>
            </button>
          </div>
        </div>
      </main>

      <!-- Sidebar -->
      <aside class="playlist-sidebar" id="playlist-sidebar">
        <div class="sidebar-header">
          <a href="/playlists" class="back-link">&larr; All playlists</a>
          <h2 class="sidebar-title">{playlist.title}</h2>
          <p class="sidebar-desc">{playlist.description}</p>
          <span class="sidebar-count">{videos.length} videos</span>
        </div>
        <ol class="sidebar-list" id="sidebar-list">
          {videos.map((v, i) => (
            <li>
              <button
                class={'sidebar-item' + (i === 0 ? ' active' : '')}
                data-index={i}
                data-video-id={v.data.videoId}
                data-title={v.data.title}
                type="button"
              >
                <span class="item-number">{i + 1}</span>
                <img
                  src={v.data.thumbnail}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="item-thumb"
                />
                <div class="item-info">
                  <span class="item-title">{v.data.title}</span>
                  <span class="item-duration">{formatDuration(v.data.duration)}</span>
                </div>
                <svg class="item-playing-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </button>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  const player = document.getElementById('playlist-player') as HTMLIFrameElement;
  const titleEl = document.getElementById('now-playing-title')!;
  const indexEl = document.getElementById('now-playing-index')!;
  const ytLink = document.getElementById('now-playing-yt-link') as HTMLAnchorElement;
  const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
  const sidebarItems = document.querySelectorAll<HTMLButtonElement>('.sidebar-item');
  const sidebar = document.getElementById('playlist-sidebar')!;
  const sidebarToggle = document.getElementById('sidebar-toggle');
  const toggleText = document.getElementById('sidebar-toggle-text');

  const total = sidebarItems.length;
  let currentIndex = 0;

  function switchTo(index: number) {
    if (index < 0 || index >= total) return;

    const btn = sidebarItems[index];
    const videoId = btn.dataset.videoId!;
    const videoTitle = btn.dataset.title!;

    currentIndex = index;

    // Update player
    player.src = 'https://www.youtube-nocookie.com/embed/' + videoId + '?autoplay=1';
    titleEl.textContent = videoTitle;
    indexEl.textContent = (index + 1) + ' / ' + total;
    ytLink.href = 'https://www.youtube.com/watch?v=' + videoId;

    // Update sidebar active state
    sidebarItems.forEach((item) => item.classList.remove('active'));
    btn.classList.add('active');

    // Scroll sidebar item into view
    btn.scrollIntoView({ block: 'nearest', behavior: 'smooth' });

    // Update nav buttons
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === total - 1;

    // Close sidebar on mobile after selection
    if (window.innerWidth < 900) {
      sidebar.classList.remove('open');
    }
  }

  // Sidebar item clicks
  sidebarItems.forEach((item) => {
    item.addEventListener('click', () => {
      const idx = parseInt(item.dataset.index!, 10);
      switchTo(idx);
    });
  });

  // Prev / Next
  prevBtn.addEventListener('click', () => switchTo(currentIndex - 1));
  nextBtn.addEventListener('click', () => switchTo(currentIndex + 1));

  // Keyboard shortcuts
  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.key === 'ArrowLeft' || e.key === 'p') {
      e.preventDefault();
      switchTo(currentIndex - 1);
    } else if (e.key === 'ArrowRight' || e.key === 'n') {
      e.preventDefault();
      switchTo(currentIndex + 1);
    }
  });

  // Mobile sidebar toggle
  if (sidebarToggle) {
    sidebarToggle.addEventListener('click', () => {
      const isOpen = sidebar.classList.toggle('open');
      if (toggleText) {
        toggleText.textContent = isOpen
          ? 'Hide playlist'
          : 'Show playlist (' + total + ')';
      }
    });
  }
</script>

<style>
  .playlist-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 1rem 3rem;
  }

  /* ── Mobile header ── */
  .playlist-mobile-header {
    display: none;
  }

  .playlist-mobile-header h1 {
    font-size: 1.5rem;
    color: var(--text-heading);
    margin: 0.5rem 0 0.25rem;
  }

  .playlist-mobile-header .playlist-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .sidebar-toggle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    cursor: pointer;
    width: 100%;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .sidebar-toggle:hover {
    border-color: var(--accent);
  }

  /* ── Layout ── */
  .playlist-layout {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .player-area {
    flex: 1;
    min-width: 0;
  }

  /* ── Player ── */
  .player-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    border-radius: 0.75rem;
    overflow: hidden;
    background: #000;
  }

  .player-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ── Now playing bar ── */
  .now-playing {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 1rem 0;
    flex-wrap: wrap;
  }

  .now-playing-info h2 {
    font-size: 1.25rem;
    color: var(--text-heading);
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }

  .now-playing-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .meta-sep { opacity: 0.5; }

  .yt-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
  }

  .yt-link:hover {
    text-decoration: underline;
  }

  .brand-feature {
    margin-right: 0.1rem;
  }

  /* ── Prev / Next ── */
  .player-nav {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 0.5rem;
    padding: 0.55rem 1rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .nav-btn:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--accent);
  }

  .nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* ── Sidebar ── */
  .playlist-sidebar {
    width: 380px;
    flex-shrink: 0;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: calc(100vh - 6rem);
    position: sticky;
    top: 5rem;
  }

  .sidebar-header {
    padding: 1.25rem 1rem 1rem;
    border-bottom: 1px solid var(--border-accent);
  }

  .sidebar-header .back-link {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    margin-bottom: 0.5rem;
  }

  .sidebar-header .back-link:hover {
    color: var(--accent);
  }

  .sidebar-title {
    font-size: 1.1rem;
    color: var(--text-heading);
    margin: 0 0 0.35rem;
    line-height: 1.3;
  }

  .sidebar-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .sidebar-count {
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    flex: 1;
  }

  .sidebar-list li {
    border-bottom: 1px solid var(--border-subtle);
  }

  .sidebar-list li:last-child {
    border-bottom: none;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.65rem 0.75rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--text-primary);
    transition: background 0.15s ease;
  }

  .sidebar-item:hover {
    background: rgba(125, 211, 252, 0.06);
  }

  .sidebar-item.active {
    background: rgba(125, 211, 252, 0.12);
    border-left: 3px solid var(--accent);
  }

  .sidebar-item.active .item-number {
    color: var(--accent);
  }

  .item-number {
    font-size: 0.8rem;
    color: var(--text-muted);
    min-width: 1.4rem;
    text-align: center;
    font-weight: 600;
    flex-shrink: 0;
  }

  .item-thumb {
    width: 80px;
    height: 45px;
    object-fit: cover;
    border-radius: 0.35rem;
    flex-shrink: 0;
  }

  .item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .item-title {
    font-size: 0.825rem;
    font-weight: 500;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .item-duration {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .item-playing-icon {
    display: none;
    color: var(--accent);
    flex-shrink: 0;
  }

  .sidebar-item.active .item-playing-icon {
    display: block;
  }

  .back-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  /* ── Responsive ── */
  @media (max-width: 899px) {
    .playlist-mobile-header {
      display: block;
      padding: 0.5rem 0 0;
    }

    .playlist-layout {
      flex-direction: column;
    }

    .playlist-sidebar {
      position: fixed;
      top: 0;
      right: 0;
      width: 100%;
      height: 100vh;
      max-height: 100vh;
      border-radius: 0;
      z-index: 100;
      transform: translateX(100%);
      transition: transform 0.3s ease;
    }

    .playlist-sidebar.open {
      transform: translateX(0);
    }

    .sidebar-header {
      position: relative;
    }
  }

  @media (min-width: 900px) {
    .playlist-mobile-header {
      display: none;
    }
  }
</style>
