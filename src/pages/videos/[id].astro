---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoCard from '../../components/VideoCard.astro';
import YouTubeBrandFeature from '../../components/YouTubeBrandFeature.astro';

export async function getStaticPaths() {
  const videos = await getCollection('videos');
  const playlists = await getCollection('playlists');

  return videos.map((video) => {
    const related = videos
      .filter((v) => v.id !== video.id)
      .map((v) => ({
        video: v,
        score: v.data.tags.filter((t) => video.data.tags.includes(t)).length,
      }))
      .filter((r) => r.score > 0)
      .sort(
        (a, b) =>
          b.score - a.score ||
          new Date(b.video.data.publishedAt).getTime() -
            new Date(a.video.data.publishedAt).getTime()
      )
      .slice(0, 6)
      .map((r) => r.video);

    // Find playlists containing this video
    const videoPlaylists = playlists
      .filter((pl) => pl.data.videos.includes(video.data.videoId))
      .map((pl) => ({ slug: pl.data.slug, title: pl.data.title }));

    return {
      params: { id: video.id },
      props: { video, relatedVideos: related, videoPlaylists },
    };
  });
}

const { video, relatedVideos, videoPlaylists } = Astro.props;
const { videoId, title, thumbnail, description, publishedAt, duration, viewCount, tags } = video.data;

function formatDuration(seconds) {
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const secs = seconds % 60;
  if (hours > 0) {
    return hours + ':' + String(minutes).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
  }
  return minutes + ':' + String(secs).padStart(2, '0');
}

function formatDate(date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
}

function formatViewCount(count) {
  if (count >= 1000000) {
    var val = (count / 1000000).toFixed(1);
    if (val.endsWith('.0')) val = val.slice(0, -2);
    return val + 'M views';
  }
  if (count >= 1000) {
    var val = (count / 1000).toFixed(1);
    if (val.endsWith('.0')) val = val.slice(0, -2);
    return val + 'K views';
  }
  return count + ' views';
}

function toIsoDuration(totalSeconds) {
  const hours = Math.floor(totalSeconds / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;

  const hoursPart = hours > 0 ? `${hours}H` : '';
  const minutesPart = minutes > 0 ? `${minutes}M` : '';
  const secondsPart = seconds > 0 || (hours === 0 && minutes === 0) ? `${seconds}S` : '';

  return `PT${hoursPart}${minutesPart}${secondsPart}`;
}

const embedUrl = 'https://www.youtube-nocookie.com/embed/' + videoId;
const youtubeUrl = 'https://www.youtube.com/watch?v=' + videoId;

const descriptionParagraphs = video.data.description
  .split('\n\n')
  .map((p) => p.trim())
  .filter((p) => p.length > 0);

const metaDescription = video.data.description.replaceAll('\n', ' ').slice(0, 160);
const pageUrl = new URL(`/videos/${video.id}/`, Astro.site).href;
const videoStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description: metaDescription,
  thumbnailUrl: [thumbnail],
  uploadDate: new Date(publishedAt).toISOString(),
  duration: toIsoDuration(duration),
  embedUrl,
  contentUrl: youtubeUrl,
  url: pageUrl,
  publisher: {
    '@type': 'Organization',
    name: 'High in the FlightSim Sky',
    url: new URL('/', Astro.site).href,
  },
};
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Videos',
      item: new URL('/videos/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: pageUrl,
    },
  ],
};
---

<BaseLayout title={title} description={metaDescription} ogType="article" image={thumbnail} imageAlt={`${title} video thumbnail`} structuredData={[videoStructuredData, breadcrumbStructuredData]}>
  <article class="video-detail">
    <div class="player-wrapper">
      <iframe
        src={embedUrl}
        title={title}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
        loading="lazy"
        class="player-iframe"
      ></iframe>
    </div>

    <div class="video-info">
      {videoPlaylists.length > 0 && (
        <div class="playlist-badges">
          {videoPlaylists.map((pl) => (
            <a href={'/playlists/' + pl.slug} class="playlist-badge">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 12.5v-9l6 4.5-6 4.5z" />
              </svg>
              Part of: {pl.title}
            </a>
          ))}
        </div>
      )}

      <h1 class="video-title">{title}</h1>

      <div class="video-meta">
        <time datetime={publishedAt.toISOString()}>
          {formatDate(publishedAt)}
        </time>
        <span class="meta-sep">&middot;</span>
        <span class="meta-duration">{formatDuration(duration)}</span>
        {viewCount > 0 && (
          <Fragment>
            <span class="meta-sep">&middot;</span>
            <span class="meta-views">{formatViewCount(viewCount)}</span>
          </Fragment>
        )}
        <YouTubeBrandFeature className="brand-feature" />
      </div>

      <div class="video-actions">
        <a
          href={youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-external"
        >
          Open on YouTube
        </a>
        <button
          class="btn btn-fav detail-fav-btn"
          data-fav-type="video"
          data-fav-id={videoId}
          title="Save to favorites"
          aria-label="Save to favorites"
          type="button"
        >
          <svg class="fav-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="fav-label">Save</span>
        </button>
      </div>

      {tags.length > 0 && (
        <div class="video-tags">
          {tags.map((tag) => (
            <a href={'/videos#tag=' + encodeURIComponent(tag)} class="tag">
              {tag}
            </a>
          ))}
        </div>
      )}

      <div class="video-description">
        {descriptionParagraphs.map((paragraph) => (
          <p set:html={paragraph.replaceAll('\n', '<br />')} />
        ))}
      </div>
    </div>

    {relatedVideos.length > 0 && (
      <section class="related-section">
        <h2 class="related-heading">Related Videos</h2>
        <div class="related-grid">
          {relatedVideos.map((related) => (
            <VideoCard video={related} />
          ))}
        </div>
      </section>
    )}

    <footer class="video-footer">
      <a href="/videos" class="back-link">&larr; Back to all videos</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .video-detail {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
  }

  .player-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    background: #000;
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .player-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-info {
    margin-top: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-accent);
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-card);
  }

  .playlist-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .playlist-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(125, 211, 252, 0.1);
    border: 1px solid rgba(125, 211, 252, 0.25);
    border-radius: 2rem;
    padding: 0.3rem 0.85rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .playlist-badge:hover {
    background: rgba(125, 211, 252, 0.2);
    border-color: var(--accent);
  }

  .video-title {
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
    color: var(--text-heading);
    line-height: 1.3;
  }

  .video-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .brand-feature {
    margin-left: 0.15rem;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .video-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    font-family: inherit;
  }

  .btn-external {
    background: var(--bg-input);
    color: var(--text-heading);
    border: 1px solid var(--border-accent);
  }

  .btn-external:hover {
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .btn-fav {
    background: var(--bg-input);
    color: var(--text-heading);
    border: 1px solid var(--border-accent);
  }

  .btn-fav:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-fav.saved {
    background: rgba(250, 204, 21, 0.15);
    border-color: #facc15;
    color: #facc15;
  }

  .btn-fav.saved .fav-icon {
    fill: #facc15;
    stroke: #facc15;
  }

  .video-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .tag {
    background: var(--tag-bg);
    color: var(--tag-text);
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    text-decoration: none;
    border: 1px solid var(--border-accent);
    transition: all 0.25s ease;
  }

  .tag:hover {
    background: rgba(14, 165, 233, 0.1);
    color: var(--accent);
    border-color: var(--accent);
  }

  .video-description {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.7;
    border-top: 1px solid var(--border-accent);
    padding-top: 1.25rem;
    word-break: break-word;
  }

  .video-description p {
    margin: 0 0 1rem;
  }

  .video-description p:last-child {
    margin-bottom: 0;
  }

  .related-section {
    margin-top: 2.5rem;
  }

  .related-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0 0 1.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .video-footer {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-accent);
  }

  .back-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 900px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .video-detail {
      padding: 1rem 0.75rem 2rem;
    }

    .player-wrapper {
      border-radius: 0.5rem;
    }

    .video-title {
      font-size: 1.35rem;
    }

    .video-info {
      padding: 1rem;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline>
  (function() {
    var btn = document.querySelector('.detail-fav-btn');
    if (!btn) return;

    var videoId = btn.getAttribute('data-fav-id');
    if (!videoId) return;

    var STORAGE_KEY = 'fav-videos';

    function getFavs() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      } catch (e) {
        return [];
      }
    }

    function updateUI() {
      var favs = getFavs();
      var isSaved = favs.indexOf(videoId) > -1;
      if (isSaved) {
        btn.classList.add('saved');
      } else {
        btn.classList.remove('saved');
      }
      var label = btn.querySelector('.fav-label');
      if (label) label.textContent = isSaved ? 'Saved' : 'Save';
    }

    btn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var favs = getFavs();
      var idx = favs.indexOf(videoId);
      if (idx > -1) {
        favs.splice(idx, 1);
      } else {
        favs.push(videoId);
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(favs));
      updateUI();
      window.dispatchEvent(new Event('favs-changed'));
    });

    updateUI();
  })();
</script>
