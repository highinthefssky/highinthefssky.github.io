---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import YouTubeBrandFeature from '../components/YouTubeBrandFeature.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) =>
    new Date(b.data.publishedAt).getTime() -
    new Date(a.data.publishedAt).getTime()
);

const allTags = Array.from(
  new Set(allPosts.flatMap((post) => post.data.tags))
);
---

<BaseLayout title="Community Posts" description="Read Microsoft Flight Simulator community posts with updates, release notes, tips, and discussions from High in the FlightSim Sky, all in one searchable archive.">
  <div class="posts-page">
    <div class="posts-header">
      <h1>Community Posts</h1>
      <p>
        Explore {allPosts.length} community posts
      </p>
      <YouTubeBrandFeature className="brand-feature" size="lg" />
    </div>

    {allTags.length > 0 && (
      <div class="filters">
        <div class="filter-group">
          <label for="tag-filter">Filter by tag:</label>
          <select id="tag-filter" class="tag-select">
            <option value="">All Tags</option>
            {allTags.map((tag) => (
              <option value={tag}>{tag}</option>
            ))}
          </select>
        </div>
      </div>
    )}

    <div class="posts-list" id="posts-list">
      {sortedPosts.map((post) => (
        <PostCard post={post} showBrandFeature={false} />
      ))}
    </div>

    {sortedPosts.length === 0 && (
      <div class="empty-state">
        <p>No posts found. Check back soon for community updates!</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .posts-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .posts-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .posts-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
  }

  .posts-header p {
    font-size: 1.125rem;
    color: var(--text-muted);
  }

  .brand-feature {
    margin-top: 0.65rem;
  }

  .filters {
    margin-bottom: 2rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-group label {
    font-weight: 500;
    color: var(--text-heading);
  }

  .tag-select {
    padding: 0.5rem 1rem;
    border: 1px solid var(--border-input);
    border-radius: 0.375rem;
    font-size: 1rem;
    background-color: var(--bg-input);
    color: var(--text-primary);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .tag-select:hover {
    border-color: var(--accent);
    background-color: #213551;
  }

  .tag-select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: #6b7280;
  }

  @media (max-width: 768px) {
    .posts-page {
      padding: 1rem;
    }

    .posts-header h1 {
      font-size: 2rem;
    }
  }
</style>

<script>
  const tagSelect = document.getElementById('tag-filter');
  const postsList = document.getElementById('posts-list');
  const postCards = postsList?.querySelectorAll('[data-tags]');

  function normalizeString(value: string): string {
    return value.toLowerCase().trim();
  }

  function getInitialTagFromUrl(): string {
    const params = new URLSearchParams(window.location.search);
    const queryTag = params.get('tag')?.trim();
    if (queryTag) return queryTag;

    if (window.location.hash.startsWith('#tag=')) {
      const hashTag = window.location.hash.slice('#tag='.length).trim();
      if (hashTag) return decodeURIComponent(hashTag);
    }

    return '';
  }

  function updatePostDisplay(selectedTag: string) {
    postCards?.forEach((card) => {
      const tags = card.getAttribute('data-tags')?.split(',') || [];
      const matches = !selectedTag || tags.includes(selectedTag.toLowerCase());
      (card as HTMLElement).style.display = matches ? '' : 'none';
    });
  }

  tagSelect?.addEventListener('change', (e) => {
    const selectedTag = (e.target as HTMLSelectElement).value;
    updatePostDisplay(selectedTag);
  });

  const initialTag = getInitialTagFromUrl();
  if (initialTag && tagSelect instanceof HTMLSelectElement) {
    const matchingOption = Array.from(tagSelect.options).find(
      (option) => normalizeString(option.value) === normalizeString(initialTag)
    );

    if (matchingOption) {
      tagSelect.value = matchingOption.value;
      updatePostDisplay(matchingOption.value);
      history.replaceState(
        null,
        '',
        `${window.location.pathname}#tag=${encodeURIComponent(matchingOption.value)}`
      );
    }
  }
</script>
