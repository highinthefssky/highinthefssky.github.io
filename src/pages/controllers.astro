---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConfigCard from '../components/ConfigCard.astro';
import KeyboardShortcuts from '../components/KeyboardShortcuts.astro';
import stats from '../content/stats.json';

const allConfigs = await getCollection('controllers');
const totalControllers = (stats as { totalControllers?: number }).totalControllers ?? allConfigs.length;
const sortedConfigs = allConfigs.sort((a, b) =>
  a.data.controller.localeCompare(b.data.controller)
);

const allTags = Array.from(
  new Set(allConfigs.flatMap((config) => config.data.tags))
).sort();

const allControllers = Array.from(
  new Set(allConfigs.map((config) => config.data.controller))
).sort();
---

<BaseLayout title="Controller Configs" description="Download ready-to-use Microsoft Flight Simulator 2024 controller configurations, filter by aircraft and tags, and quickly find the best setup for your hardware.">
  <div class="controllers-page">
    <div class="controllers-header">
      <h1>🎮 Controller Configurations</h1>
      <p>
        Download ready-to-use control profiles for {totalControllers} different controller setups
      </p>
      <div class="header-info">
        <a 
          href="https://github.com/highinthefssky/msfs-2024-controls-settings" 
          target="_blank" 
          rel="noopener noreferrer"
          class="github-link"
        >
          📦 View on GitHub
        </a>
        <span class="separator">•</span>
        <a href="/controllers/wizard" class="github-link">🧭 Match Wizard</a>
        <span class="separator">•</span>
        <span class="info-text">Compatible with MSFS 2024</span>
      </div>

      <div class="wizard-entry">
        <h2>Need help picking the right setup?</h2>
        <p>Use the 3-step Controller Match Wizard to get your best config and related training videos.</p>
        <div class="wizard-entry-links">
          <a href="/controllers/wizard" class="wizard-btn wizard-btn-primary">Open Match Wizard</a>
          <a href="/controllers/wizard?aircraft=airliner&goal=airliner-ops" class="wizard-btn">Airliner preset</a>
          <a href="/controllers/wizard?aircraft=general&goal=navigation" class="wizard-btn">GA + IFR preset</a>
        </div>
      </div>

      <div class="moza-entry">
        <div class="moza-entry-icon">🕹️</div>
        <div class="moza-entry-content">
          <h2>Moza Cockpit users?</h2>
          <p>Download import-ready <code>.preset</code> files for your Moza flight device.</p>
        </div>
        <a href="/controllers/moza" class="wizard-btn wizard-btn-moza">View Moza Profiles →</a>
      </div>
    </div>

    <div class="search-controls">
      <div class="search-box">
        <label class="search-label" for="search-input">Search controller configurations</label>
        <div class="search-input-wrap">
          <input
            type="text"
            id="search-input"
            placeholder="Search configs (e.g. controller:VelocityOne, aircraft:A321, TBM930)"
            class="search-input"
            autocomplete="off"
          />
          <kbd class="search-kbd-hint" title="Press / to focus">/</kbd>
          <span class="search-icon" aria-hidden="true">🔍</span>
        </div>
      </div>

      <div class="filter-section">
        <div class="filter-header">
          <h3>Filter by Controller</h3>
          <button id="toggle-controllers" class="toggle-btn" type="button">▼</button>
        </div>
        <div class="filter-container" id="controller-container" style="display: none;">
          <div class="filter-list" id="controllers-list">
            {allControllers.map((controller) => (
              <button
                class="filter-btn controller-filter"
                data-controller={controller}
                type="button"
              >
                {controller}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="filter-section">
        <div class="filter-header">
          <h3>Filter by Tags</h3>
          <button id="toggle-tags" class="toggle-btn" type="button">▼</button>
        </div>
        <div class="filter-container" id="tag-container" style="display: none;">
          <label class="search-label" for="tag-search">Search controller tags</label>
          <input
            type="text"
            id="tag-search"
            placeholder="Search tags..."
            class="tag-search-input"
            autocomplete="off"
          />
          <div class="filter-list" id="tags-list">
            {allTags.map((tag) => (
              <button
                class="filter-btn tag-filter"
                data-tag={tag}
                type="button"
              >
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="selected-filters" id="selected-filters"></div>

      <div class="controls-footer">
        <span id="result-count" class="result-count" data-total-configs={totalControllers}>
          {totalControllers} configurations
        </span>
        <button id="clear-btn" class="btn-clear" type="button">
          Clear all filters
        </button>
      </div>
    </div>

    <div class="search-results">
      <div class="configs-grid" id="configs-grid">
        {sortedConfigs.map((config) => (
          <ConfigCard config={config} />
        ))}
      </div>

      <div class="empty-state" id="empty-state" style="display: none;">
        <p>No controller configurations found matching your search.</p>
        <button id="reset-btn" class="btn-reset">Reset filters</button>
      </div>
    </div>
  </div>
  <KeyboardShortcuts shortcuts={[
    { key: '/', label: 'Focus search' },
    { key: 'Esc', label: 'Clear all filters' },
    { key: 'c', label: 'Toggle controller filters' },
    { key: 't', label: 'Toggle tag filters' },
  ]} />
</BaseLayout>

<style>
  .controllers-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .controllers-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .controllers-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
  }

  .controllers-header p {
    font-size: 1.125rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .header-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .github-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease;
  }

  .github-link:hover {
    color: #38bdf8;
  }

  .separator {
    color: #64748b;
  }

  .info-text {
    color: var(--text-muted);
  }

  .wizard-entry {
    margin-top: 1.25rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 1rem;
  }

  .wizard-entry h2 {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
    color: var(--text-heading);
  }

  .wizard-entry p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .wizard-entry-links {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 0.85rem;
  }

  .wizard-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    padding: 0.6rem 0.9rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-input);
    background: var(--bg-input);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .wizard-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .wizard-btn-primary {
    background: hsl(213, 94%, 47%);
    color: white;
    border-color: hsl(213, 94%, 47%);
  }

  .wizard-btn-primary:hover {
    background: hsl(213, 94%, 37%);
    border-color: hsl(213, 94%, 37%);
    color: white;
  }

  .moza-entry {
    margin-top: 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .moza-entry-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .moza-entry-content {
    flex: 1;
    min-width: 180px;
    text-align: left;
  }

  .moza-entry-content h2 {
    margin: 0 0 0.2rem;
    font-size: 1.05rem;
    color: var(--text-heading);
  }

  .moza-entry-content p {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .moza-entry-content code {
    font-family: 'JetBrains Mono', monospace;
    background: var(--bg-panel);
    border: 1px solid var(--border-default);
    border-radius: 0.25rem;
    padding: 0.05rem 0.3rem;
    font-size: 0.85em;
  }

  .wizard-btn-moza {
    background: hsl(262, 70%, 48%);
    color: white;
    border-color: hsl(262, 70%, 48%);
    white-space: nowrap;
  }

  .wizard-btn-moza:hover {
    background: hsl(262, 70%, 38%);
    border-color: hsl(262, 70%, 38%);
    color: white;
  }

  .search-controls {
    background: var(--bg-panel);
    padding: 2rem;
    border-radius: 0.75rem;
    margin-bottom: 2rem;
    border: 1px solid var(--border-default);
  }

  .search-box {
    margin-bottom: 2rem;
  }

  .search-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-heading);
    font-weight: 600;
  }

  .search-input-wrap {
    position: relative;
  }

  .search-input {
    width: 100%;
    padding: 1rem;
    padding-right: 2.5rem;
    font-size: 1rem;
    border: 2px solid var(--border-input);
    border-radius: 0.5rem;
    background: var(--bg-input);
    color: var(--text-primary);
    transition: all 0.3s ease;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
  }

  .search-input::placeholder {
    color: var(--text-input-placeholder);
  }

  .search-icon {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.25rem;
    pointer-events: none;
  }

  .search-kbd-hint {
    position: absolute;
    right: 2.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    border-radius: 0.25rem;
    background: var(--bg-surface);
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    pointer-events: none;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .search-input:focus ~ .search-kbd-hint {
    opacity: 0;
  }

  .filter-section {
    margin-bottom: 1.5rem;
  }

  .filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .filter-header h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0;
  }

  .toggle-btn {
    background: transparent;
    border: none;
    color: var(--accent);
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.3s ease;
    padding: 0.25rem;
  }

  .toggle-btn.open {
    transform: rotate(180deg);
  }

  .filter-container {
    margin-top: 1rem;
  }

  .tag-search-input {
    width: 100%;
    padding: 0.625rem;
    font-size: 0.875rem;
    border: 2px solid var(--border-input);
    border-radius: 0.375rem;
    background: var(--bg-input);
    color: var(--text-primary);
    margin-bottom: 1rem;
    transition: all 0.3s ease;
  }

  .tag-search-input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
  }

  .tag-search-input::placeholder {
    color: var(--text-input-placeholder);
  }

  .filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    max-height: 200px;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border: 2px solid var(--border-input);
    background: var(--bg-input);
    color: var(--text-secondary);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .filter-btn.active {
    background: #7dd3fc;
    border-color: var(--accent);
    color: #0f1b2e;
    font-weight: 600;
  }

  .selected-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 1.5rem;
    min-height: 2rem;
  }

  .controls-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-default);
  }

  .result-count {
    color: var(--text-muted);
    font-weight: 600;
    font-size: 1rem;
  }

  .btn-clear {
    background: transparent;
    border: 2px solid var(--border-input);
    color: var(--text-secondary);
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-clear:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--text-heading);
  }

  .btn-clear:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .search-results {
    min-height: 400px;
  }

  .configs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }

  .empty-state p {
    font-size: 1.125rem;
    margin-bottom: 1.5rem;
  }

  .btn-reset {
    background: hsl(213, 94%, 47%);
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.375rem;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-reset:hover {
    background: hsl(213, 94%, 37%);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .controllers-page {
      padding: 1rem;
    }

    .controllers-header h1 {
      font-size: 2rem;
    }

    .search-controls {
      padding: 1.5rem;
    }

    .wizard-entry-links {
      align-items: stretch;
    }

    .wizard-btn {
      width: 100%;
    }

    .controls-footer {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .configs-grid {
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1rem;
    }
  }
</style>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const tagSearchInput = document.getElementById('tag-search') as HTMLInputElement;
  const toggleControllersBtn = document.getElementById('toggle-controllers') as HTMLButtonElement;
  const toggleTagsBtn = document.getElementById('toggle-tags') as HTMLButtonElement;
  const controllerContainer = document.getElementById('controller-container') as HTMLDivElement;
  const tagContainer = document.getElementById('tag-container') as HTMLDivElement;
  const controllerButtons = document.querySelectorAll('.controller-filter');
  const tagButtons = document.querySelectorAll('.tag-filter');
  const configsGrid = document.getElementById('configs-grid');
  const emptyState = document.getElementById('empty-state');
  const configCards = document.querySelectorAll('.config-card');
  const resultCount = document.getElementById('result-count');
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  const resetBtn = document.getElementById('reset-btn');
  const selectedFiltersContainer = document.getElementById('selected-filters') as HTMLDivElement;
  const totalConfigs = Number(resultCount?.getAttribute('data-total-configs') || '0');

  let activeControllers = new Set<string>();
  let activeTags = new Set<string>();

  // Toggle filter visibility
  toggleControllersBtn?.addEventListener('click', () => {
    const isOpen = controllerContainer.style.display !== 'none';
    controllerContainer.style.display = isOpen ? 'none' : 'block';
    toggleControllersBtn.classList.toggle('open');
  });

  toggleTagsBtn?.addEventListener('click', () => {
    const isOpen = tagContainer.style.display !== 'none';
    tagContainer.style.display = isOpen ? 'none' : 'block';
    toggleTagsBtn.classList.toggle('open');
  });

  function normalizeString(str: string): string {
    return str.toLowerCase().trim();
  }

  function parseSearchQuery(raw: string): { term: string; field: 'all' | 'controller' | 'aircraft' } {
    const trimmed = raw.trim();
    if (!trimmed) return { term: '', field: 'all' };
    const lower = trimmed.toLowerCase();
    if (lower.startsWith('controller:')) {
      return { term: trimmed.slice('controller:'.length).trim(), field: 'controller' };
    }
    if (lower.startsWith('aircraft:')) {
      return { term: trimmed.slice('aircraft:'.length).trim(), field: 'aircraft' };
    }
    return { term: trimmed, field: 'all' };
  }

  function updateSelectedFiltersDisplay() {
    selectedFiltersContainer.innerHTML = '';
    
    activeControllers.forEach((controller) => {
      const filterBtn = document.createElement('button');
      filterBtn.className = 'filter-btn active';
      filterBtn.textContent = `${controller} ✕`;
      filterBtn.type = 'button';
      filterBtn.addEventListener('click', () => {
        activeControllers.delete(controller);
        document.querySelector(`[data-controller="${controller}"]`)?.classList.remove('active');
        updateSelectedFiltersDisplay();
        updateDisplay();
      });
      selectedFiltersContainer.appendChild(filterBtn);
    });

    activeTags.forEach((tag) => {
      const filterBtn = document.createElement('button');
      filterBtn.className = 'filter-btn active';
      filterBtn.textContent = `${tag} ✕`;
      filterBtn.type = 'button';
      filterBtn.addEventListener('click', () => {
        activeTags.delete(tag);
        document.querySelector(`[data-tag="${tag}"]`)?.classList.remove('active');
        updateSelectedFiltersDisplay();
        updateDisplay();
      });
      selectedFiltersContainer.appendChild(filterBtn);
    });
  }

  function updateDisplay() {
    let visibleCount = 0;
    const { term, field } = parseSearchQuery(searchInput.value || '');
    const searchTerm = normalizeString(term);

    configCards.forEach((card) => {
      const cardEl = card as HTMLElement;
      const tags = (cardEl.getAttribute('data-tags') || '')
        .split(',')
        .filter((t) => t)
        .map(normalizeString);
      const controller = normalizeString(cardEl.getAttribute('data-controller') || '');
      const settings = normalizeString(cardEl.getAttribute('data-settings') || '');
      const description = normalizeString(cardEl.querySelector('.config-description')?.textContent || '');
      const aircraft = normalizeString(cardEl.querySelector('.aircraft-badge')?.textContent || '');

      const matchesSearch =
        !searchTerm ||
        (field === 'controller' && controller.includes(searchTerm)) ||
        (field === 'aircraft' && aircraft.includes(searchTerm)) ||
        (field === 'all' && (
          controller.includes(searchTerm) || 
          description.includes(searchTerm) || 
          aircraft.includes(searchTerm) ||
          settings.includes(searchTerm)
        ));

      const matchesControllers =
        activeControllers.size === 0 ||
        Array.from(activeControllers).some((c) => controller.includes(normalizeString(c)));

      const matchesTags =
        activeTags.size === 0 ||
        Array.from(activeTags).some((tag) => tags.includes(normalizeString(tag)));

      const shouldShow = matchesSearch && matchesControllers && matchesTags;
      cardEl.style.display = shouldShow ? '' : 'none';

      if (shouldShow) visibleCount++;
    });

    const hasFilters = activeControllers.size > 0 || activeTags.size > 0 || !!searchInput.value.trim();

    if (!hasFilters) {
      configCards.forEach((card) => {
        (card as HTMLElement).style.display = '';
      });
      visibleCount = totalConfigs;
    }

    resultCount!.textContent = `${visibleCount} ${visibleCount === 1 ? 'configuration' : 'configurations'}`;
    emptyState!.style.display = visibleCount === 0 ? 'block' : 'none';
    configsGrid!.style.display = visibleCount === 0 ? 'none' : 'grid';
    clearBtn!.disabled = !hasFilters;
  }

  // Tag search filter
  tagSearchInput?.addEventListener('input', (e) => {
    const searchTerm = normalizeString((e.target as HTMLInputElement).value);
    tagButtons.forEach((btn) => {
      const tagText = normalizeString(btn.getAttribute('data-tag') || '');
      (btn as HTMLElement).style.display = !searchTerm || tagText.includes(searchTerm) ? '' : 'none';
    });
  });

  searchInput?.addEventListener('input', updateDisplay);

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      updateDisplay();
    }
  });

  // Controller filter buttons
  controllerButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const controller = button.getAttribute('data-controller');
      if (controller) {
        if (activeControllers.has(controller)) {
          activeControllers.delete(controller);
          button.classList.remove('active');
        } else {
          activeControllers.add(controller);
          button.classList.add('active');
        }
        updateSelectedFiltersDisplay();
        updateDisplay();
      }
    });
  });

  // Tag filter buttons
  tagButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.getAttribute('data-tag');
      if (tag) {
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
          button.classList.remove('active');
        } else {
          activeTags.add(tag);
          button.classList.add('active');
        }
        updateSelectedFiltersDisplay();
        updateDisplay();
      }
    });
  });

  clearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    tagSearchInput.value = '';
    activeControllers.clear();
    activeTags.clear();
    controllerButtons.forEach((btn) => {
      btn.classList.remove('active');
    });
    tagButtons.forEach((btn) => {
      btn.classList.remove('active');
      (btn as HTMLElement).style.display = '';
    });
    updateSelectedFiltersDisplay();
    updateDisplay();
  });

  resetBtn?.addEventListener('click', () => {
    searchInput.value = '';
    tagSearchInput.value = '';
    activeControllers.clear();
    activeTags.clear();
    controllerButtons.forEach((btn) => {
      btn.classList.remove('active');
    });
    tagButtons.forEach((btn) => {
      btn.classList.remove('active');
      (btn as HTMLElement).style.display = '';
    });
    updateSelectedFiltersDisplay();
    updateDisplay();
  });

  // ── Keyboard shortcuts ──
  document.addEventListener('keydown', (e) => {
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') {
      if (e.key === 'Escape') {
        (e.target as HTMLElement).blur();
      }
      return;
    }

    // Don't fire shortcuts when the help overlay is open
    if (document.getElementById('kbd-help')?.classList.contains('open')) return;

    if (e.key === '/') {
      e.preventDefault();
      searchInput?.focus();
    } else if (e.key === 'Escape') {
      e.preventDefault();
      searchInput.value = '';
      tagSearchInput.value = '';
      activeControllers.clear();
      activeTags.clear();
      controllerButtons.forEach((btn) => {
        btn.classList.remove('active');
      });
      tagButtons.forEach((btn) => {
        btn.classList.remove('active');
        (btn as HTMLElement).style.display = '';
      });
      updateSelectedFiltersDisplay();
      updateDisplay();
    } else if (e.key === 'c') {
      e.preventDefault();
      toggleControllersBtn?.click();
    } else if (e.key === 't') {
      e.preventDefault();
      toggleTagsBtn?.click();
    }
  });

  // Initialize
  updateSelectedFiltersDisplay();
  updateDisplay();
</script>
