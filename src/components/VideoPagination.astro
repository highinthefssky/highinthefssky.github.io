---
import { videoPageUrl, videoPageWindow } from '../utils/videoPagination';

interface Props {
  page: number;
  totalPages: number;
}

const { page, totalPages } = Astro.props;
const pages = videoPageWindow(page, totalPages);
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Video pages">
    {page > 1 && <a href={videoPageUrl(page - 1)} rel="prev">Previous</a>}
    <div class="page-numbers">
      {pages[0] > 1 && <a href={videoPageUrl(1)} aria-label="Page 1">1</a>}
      {pages[0] > 2 && <span aria-hidden="true">...</span>}
      {pages.map((number) => (
        <a href={videoPageUrl(number)} aria-label={`Page ${number}`} aria-current={number === page ? 'page' : undefined}>{number}</a>
      ))}
      {pages[pages.length - 1] < totalPages - 1 && <span aria-hidden="true">...</span>}
      {pages[pages.length - 1] < totalPages && <a href={videoPageUrl(totalPages)} aria-label={`Page ${totalPages}`}>{totalPages}</a>}
    </div>
    {page < totalPages && <a href={videoPageUrl(page + 1)} rel="next">Next</a>}
  </nav>
)}

<style>
  .pagination, .page-numbers {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pagination { margin-top: 2rem; }
  a {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border-input);
    border-radius: 0.375rem;
    color: var(--text-primary);
    text-decoration: none;
  }
  a:hover, a[aria-current="page"] {
    border-color: var(--accent);
    background: var(--bg-input);
    color: var(--accent);
  }
  a[aria-current="page"] { font-weight: 700; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  span { color: var(--text-muted); }
</style>