---
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="navbar">
  <div class="navbar-container">
    <a href="/" class="navbar-logo">
      High in the FlightSim Sky
    </a>
    <div class="navbar-right">
    <ul class="navbar-menu">
      <li>
        <a href="/" class="navbar-link" data-link="/">Home</a>
      </li>
      <li>
        <a href="/videos/" class="navbar-link" data-link="/videos">Videos</a>
      </li>
      <li>
        <a href="/playlists" class="navbar-link" data-link="/playlists">Playlists</a>
      </li>
      <li>
        <a href="/tracks" class="navbar-link" data-link="/tracks">Tracks <span class="beta-badge">Beta</span></a>
      </li>
      <li class="navbar-dropdown">
        <button class="navbar-link dropdown-toggle" id="tools-dropdown-btn" type="button">
          Tools & Resources
          <svg class="dropdown-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="dropdown-menu" id="tools-dropdown">
          <a href="/controllers" class="dropdown-item" data-link="/controllers">🎮 Controllers</a>
          <a href="/community2024" class="dropdown-item" data-link="/community2024">📁 Community2024</a>
          <a href="/tools/community-folder-troubleshooter" class="dropdown-item" data-link="/tools/community-folder-troubleshooter">🧰 Community Folder Troubleshooter <span class="beta-badge">Beta</span></a>
        </div>
      </li>
      <li>
        <a href="/posts" class="navbar-link" data-link="/posts">Community</a>
      </li>
      <li>
        <a href="/feed" class="navbar-link" data-link="/feed">Feed</a>
      </li>
      <li>
        <a href="/contact" class="navbar-link" data-link="/contact">Contact</a>
      </li>
      <li>
        <a href="/favorites" class="navbar-link navbar-link-fav" data-link="/favorites" title="Favorites">
          <svg class="fav-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
          <span class="fav-nav-count" id="fav-nav-count" style="display: none;">0</span>
        </a>
      </li>
    </ul>
    <ThemeToggle />
    </div>
  </div>
</nav>

<script>
  function updateActiveLink() {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll('.navbar-link, .dropdown-item');
    
    links.forEach((link) => {
      const linkPath = link.getAttribute('data-link');
      link.classList.remove('active');
      
      if (linkPath === '/' && currentPath === '/') {
        link.classList.add('active');
      } else if (linkPath && linkPath !== '/' && currentPath.startsWith(linkPath)) {
        link.classList.add('active');
        // If a dropdown item is active, also highlight the dropdown button
        if (link.classList.contains('dropdown-item')) {
          const dropdownBtn = document.querySelector('.dropdown-toggle');
          if (dropdownBtn) {
            dropdownBtn.classList.add('active');
          }
        }
      }
    });
  }
  
  // Update on page load
  updateActiveLink();
  
  // Update on navigation
  window.addEventListener('popstate', updateActiveLink);

  // Dropdown menu functionality
  const dropdownBtn = document.getElementById('tools-dropdown-btn');
  const dropdownMenu = document.getElementById('tools-dropdown');
  
  if (dropdownBtn && dropdownMenu) {
    dropdownBtn.addEventListener('click', (e) => {
      e.preventDefault();
      dropdownMenu.classList.toggle('active');
    });

    // Close dropdown when clicking a link
    dropdownMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        dropdownMenu.classList.remove('active');
      });
    });

    // Close dropdown when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Element) || !target.closest('.navbar-dropdown')) {
        dropdownMenu.classList.remove('active');
      }
    });
  }

  // Favorites count badge + filled icon
  function updateFavCount() {
    const vids = JSON.parse(localStorage.getItem('fav-videos') || '[]').length;
    const cfgs = JSON.parse(localStorage.getItem('fav-configs') || '[]').length;
    const total = vids + cfgs;
    const badge = document.getElementById('fav-nav-count');
    const favLink = document.querySelector('.navbar-link-fav');
    if (badge) {
      badge.textContent = String(total);
      badge.style.display = total > 0 ? '' : 'none';
    }
    if (favLink) {
      favLink.classList.toggle('has-favorites', total > 0);
    }
  }
  updateFavCount();
  window.addEventListener('favorites-changed', updateFavCount);
  window.addEventListener('storage', updateFavCount);
</script>

<style>
  .navbar {
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-accent);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(12px);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .navbar-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .navbar-logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .navbar-logo:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .navbar-menu {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .navbar-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease, transform 0.2s ease, background 0.2s ease;
    display: inline-block;
    padding: 0.35rem 0.5rem;
    border-radius: 0.5rem;
  }

  .beta-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.35rem;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    color: #0b1e33;
    background: var(--accent);
    vertical-align: middle;
  }

  .navbar-link:hover {
    color: var(--accent);
    transform: translateY(-1px);
    background: rgba(125, 211, 252, 0.08);
  }

  .navbar-link.active {
    color: var(--accent);
    background: rgba(125, 211, 252, 0.12);
  }

  .navbar-link-fav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border-radius: 0.5rem;
    border: 1px solid var(--border-input, #3d5170);
    background: var(--bg-input, #1a2a3f);
    color: var(--accent, #7dd3fc);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    position: relative;
  }

  .navbar-link-fav:hover {
    border-color: var(--accent, #7dd3fc);
    background: var(--bg-input, #1a2a3f);
    transform: translateY(-1px);
  }

  .fav-nav-icon {
    flex-shrink: 0;
  }

  .fav-nav-count {
    position: absolute;
    top: -0.35rem;
    right: -0.35rem;
    font-size: 0.625rem;
    font-weight: 700;
    background: hsl(213, 94%, 47%);
    color: white;
    min-width: 1rem;
    height: 1rem;
    line-height: 1rem;
    text-align: center;
    border-radius: 9999px;
    padding: 0 0.25rem;
  }

  .navbar-link-fav.has-favorites .fav-nav-icon {
    fill: var(--accent, #7dd3fc);
  }

  /* Dropdown menu styles */
  .navbar-dropdown {
    position: relative;
  }

  .dropdown-toggle {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: inherit;
  }

  .dropdown-icon {
    transition: transform 0.2s ease;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 200px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: 0.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-10px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    z-index: 1000;
  }

  .dropdown-menu.active {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-toggle.active {
    color: var(--accent);
  }

  .dropdown-toggle.active .dropdown-icon {
    transform: rotate(180deg);
  }

  .dropdown-item {
    display: block;
    padding: 0.75rem 1rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
    border: none;
    background: none;
    text-align: left;
    cursor: pointer;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .dropdown-item:first-child {
    border-radius: 0.375rem 0.375rem 0 0;
  }

  .dropdown-item:last-child {
    border-radius: 0 0 0.375rem 0.375rem;
  }

  .dropdown-item:hover {
    background: var(--bg-surface);
    color: var(--accent);
  }

  .dropdown-item.active {
    background: rgba(125, 211, 252, 0.12);
    color: var(--accent);
  }

  @media (max-width: 768px) {
    .navbar-container {
      flex-direction: column;
      gap: 1rem;
    }

    .navbar-right {
      flex-direction: column;
      gap: 0.75rem;
    }

    .navbar-menu {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .navbar-logo {
      font-size: 1.25rem;
    }

    .navbar-link {
      font-size: 0.95rem;
    }

    .dropdown-menu {
      position: fixed;
      width: 90vw;
      max-width: 300px;
      left: 50%;
      transform: translateX(-50%);
    }

    .dropdown-menu.active {
      transform: translateX(-50%) translateY(0);
    }
  }
</style>
