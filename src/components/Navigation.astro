---
import ThemeToggle from './ThemeToggle.astro';
---

<nav class="navbar">
  <div class="navbar-container">
    <a href="/" class="navbar-logo">
      High in the FlightSim Sky
    </a>
    <div class="navbar-right">
    <ul class="navbar-menu">
      <li>
        <a href="/" class="navbar-link" data-link="/">Home</a>
      </li>
      <li>
        <a href="/videos/" class="navbar-link" data-link="/videos">Videos</a>
      </li>
      <li>
        <a href="/playlists" class="navbar-link" data-link="/playlists">Playlists</a>
      </li>
      <li>
        <a href="/tracks" class="navbar-link" data-link="/tracks">Tracks <span class="beta-badge">Beta</span></a>
      </li>
      <li>
        <a href="/controllers" class="navbar-link" data-link="/controllers">Controllers</a>
      </li>
      <li>
        <a href="/posts" class="navbar-link" data-link="/posts">Community</a>
      </li>
      <li>
        <a href="/feed" class="navbar-link" data-link="/feed">Feed</a>
      </li>
      <li>
        <a href="/contact" class="navbar-link" data-link="/contact">Contact</a>
      </li>
      <li>
        <a href="/favorites" class="navbar-link navbar-link-fav" data-link="/favorites" title="Favorites">
          <svg class="fav-nav-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
          <span class="fav-nav-count" id="fav-nav-count" style="display: none;">0</span>
        </a>
      </li>
    </ul>
    <ThemeToggle />
    </div>
  </div>
</nav>

<script>
  function updateActiveLink() {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll('.navbar-link');
    
    links.forEach((link) => {
      const linkPath = link.getAttribute('data-link');
      link.classList.remove('active');
      
      if (linkPath === '/' && currentPath === '/') {
        link.classList.add('active');
      } else if (linkPath && linkPath !== '/' && currentPath.startsWith(linkPath)) {
        link.classList.add('active');
      }
    });
  }
  
  // Update on page load
  updateActiveLink();
  
  // Update on navigation
  window.addEventListener('popstate', updateActiveLink);

  // Favorites count badge + filled icon
  function updateFavCount() {
    const vids = JSON.parse(localStorage.getItem('fav-videos') || '[]').length;
    const cfgs = JSON.parse(localStorage.getItem('fav-configs') || '[]').length;
    const total = vids + cfgs;
    const badge = document.getElementById('fav-nav-count');
    const favLink = document.querySelector('.navbar-link-fav');
    if (badge) {
      badge.textContent = String(total);
      badge.style.display = total > 0 ? '' : 'none';
    }
    if (favLink) {
      favLink.classList.toggle('has-favorites', total > 0);
    }
  }
  updateFavCount();
  window.addEventListener('favorites-changed', updateFavCount);
  window.addEventListener('storage', updateFavCount);
</script>

<style>
  .navbar {
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-accent);
    position: sticky;
    top: 0;
    z-index: 50;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    backdrop-filter: blur(12px);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .navbar-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .navbar-logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-heading);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .navbar-logo:hover {
    color: var(--accent);
    transform: translateY(-1px);
  }

  .navbar-menu {
    display: flex;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .navbar-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .navbar-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s ease, transform 0.2s ease, background 0.2s ease;
    display: inline-block;
    padding: 0.35rem 0.5rem;
    border-radius: 0.5rem;
  }

  .beta-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: 0.35rem;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    color: #0b1e33;
    background: var(--accent);
    vertical-align: middle;
  }

  .navbar-link:hover {
    color: var(--accent);
    transform: translateY(-1px);
    background: rgba(125, 211, 252, 0.08);
  }

  .navbar-link.active {
    color: var(--accent);
    background: rgba(125, 211, 252, 0.12);
  }

  .navbar-link-fav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border-radius: 0.5rem;
    border: 1px solid var(--border-input, #3d5170);
    background: var(--bg-input, #1a2a3f);
    color: var(--accent, #7dd3fc);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    position: relative;
  }

  .navbar-link-fav:hover {
    border-color: var(--accent, #7dd3fc);
    background: var(--bg-input, #1a2a3f);
    transform: translateY(-1px);
  }

  .fav-nav-icon {
    flex-shrink: 0;
  }

  .fav-nav-count {
    position: absolute;
    top: -0.35rem;
    right: -0.35rem;
    font-size: 0.625rem;
    font-weight: 700;
    background: hsl(213, 94%, 47%);
    color: white;
    min-width: 1rem;
    height: 1rem;
    line-height: 1rem;
    text-align: center;
    border-radius: 9999px;
    padding: 0 0.25rem;
  }

  .navbar-link-fav.has-favorites .fav-nav-icon {
    fill: var(--accent, #7dd3fc);
  }

  @media (max-width: 768px) {
    .navbar-container {
      flex-direction: column;
      gap: 1rem;
    }

    .navbar-right {
      flex-direction: column;
      gap: 0.75rem;
    }

    .navbar-menu {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .navbar-logo {
      font-size: 1.25rem;
    }

    .navbar-link {
      font-size: 0.95rem;
    }
  }
</style>
