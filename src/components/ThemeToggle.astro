---
// Theme toggle: switches between dark (default) and light mode
// Persists preference to localStorage; syncs with system preference on first visit
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Toggle light/dark theme"
  title="Toggle theme"
>
  <!-- Sun icon (shown in dark mode → click to go light) -->
  <svg class="icon icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <!-- Moon icon (shown in light mode → click to go dark) -->
  <svg class="icon icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script>
  const toggle = document.getElementById('theme-toggle');

  function setTheme(theme: 'dark' | 'light') {
    document.documentElement.classList.toggle('light', theme === 'light');
    localStorage.setItem('theme', theme);
  }

  toggle?.addEventListener('click', () => {
    const isLight = document.documentElement.classList.contains('light');
    setTheme(isLight ? 'dark' : 'light');
  });
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    border: 1px solid var(--border-input, #3d5170);
    background: var(--bg-input, #1a2a3f);
    color: var(--accent, #7dd3fc);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
  }

  .theme-toggle:hover {
    border-color: var(--accent, #7dd3fc);
    transform: translateY(-1px);
  }

  /* In dark mode: show sun, hide moon */
  .icon-sun { display: block; }
  .icon-moon { display: none; }

  /* In light mode: show moon, hide sun */
  :global(html.light) .icon-sun { display: none; }
  :global(html.light) .icon-moon { display: block; }
</style>
