---
interface Shortcut {
  key: string;
  label: string;
}

interface Props {
  shortcuts: Shortcut[];
}

const { shortcuts } = Astro.props;
---

<div class="kbd-help" id="kbd-help" aria-hidden="true">
  <div class="kbd-help-inner">
    <div class="kbd-help-title">
      <span>Keyboard Shortcuts</span>
      <button class="kbd-help-close" id="kbd-help-close" type="button" aria-label="Close shortcuts help">✕</button>
    </div>
    <ul class="kbd-list">
      {shortcuts.map((s) => (
        <li>
          <kbd>{s.key}</kbd>
          <span>{s.label}</span>
        </li>
      ))}
      <li>
        <kbd>?</kbd>
        <span>Show / hide this help</span>
      </li>
    </ul>
  </div>
</div>

<div class="kbd-hint" id="kbd-hint" title="Keyboard shortcuts available — press ? for help">
  <kbd>?</kbd>
</div>

<style>
  /* ── Floating hint badge ── */
  .kbd-hint {
    position: fixed;
    bottom: 5.5rem;
    right: 1.5rem;
    z-index: 90;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  .kbd-hint:hover {
    opacity: 1;
  }

  .kbd-hint kbd {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-size: 1rem;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    border-radius: 0.375rem;
    background: var(--bg-panel);
    color: var(--text-muted);
    border: 1px solid var(--border-default);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  /* ── Help overlay ── */
  .kbd-help {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    align-items: center;
    justify-content: center;
  }

  .kbd-help.open {
    display: flex;
  }

  .kbd-help-inner {
    background: var(--bg-panel);
    border: 1px solid var(--border-accent);
    border-radius: 0.75rem;
    padding: 1.5rem 2rem;
    min-width: 280px;
    max-width: 380px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  .kbd-help-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text-heading);
  }

  .kbd-help-close {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 1.1rem;
    cursor: pointer;
    padding: 0.25rem;
    line-height: 1;
    transition: color 0.2s;
  }

  .kbd-help-close:hover {
    color: var(--text-heading);
  }

  .kbd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .kbd-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.925rem;
    color: var(--text-primary);
  }

  .kbd-list kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 1.75rem;
    padding: 0 0.5rem;
    font-size: 0.8rem;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    border-radius: 0.3rem;
    background: var(--bg-input);
    color: var(--text-heading);
    border: 1px solid var(--border-input);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  @media (max-width: 768px) {
    .kbd-hint {
      display: none;
    }

    .kbd-help {
      display: none !important;
    }
  }
</style>

<script>
  const helpOverlay = document.getElementById('kbd-help');
  const helpClose = document.getElementById('kbd-help-close');
  const hintBadge = document.getElementById('kbd-hint');

  function toggleHelp() {
    helpOverlay?.classList.toggle('open');
    const isOpen = helpOverlay?.classList.contains('open');
    helpOverlay?.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
  }

  // Close on button click
  helpClose?.addEventListener('click', toggleHelp);

  // Close on backdrop click
  helpOverlay?.addEventListener('click', (e) => {
    if (e.target === helpOverlay) toggleHelp();
  });

  // Open from hint badge
  hintBadge?.addEventListener('click', toggleHelp);

  // Listen for ? key (handled globally, the page scripts dispatch the rest)
  document.addEventListener('keydown', (e) => {
    // Don't trigger when typing in inputs
    const tag = (e.target as HTMLElement).tagName;
    if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

    if (e.key === '?' || (e.shiftKey && e.key === '/')) {
      e.preventDefault();
      toggleHelp();
    }

    // Escape closes help overlay if it's open
    if (e.key === 'Escape' && helpOverlay?.classList.contains('open')) {
      e.preventDefault();
      toggleHelp();
    }
  });
</script>
