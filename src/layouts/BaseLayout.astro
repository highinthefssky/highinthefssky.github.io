---
import Navigation from '../components/Navigation.astro';
import LiveBanner from '../components/LiveBanner.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { title = 'High in the FlightSim Sky', description = 'Flight simulator videos, community posts, and curated learning resources', image, imageAlt, ogType = 'website', canonical, noindex = false, structuredData } = Astro.props;
const siteTitle = title === 'High in the FlightSim Sky' ? title : `${title} | High in the FlightSim Sky`;
const ogImage = image
  ? (image.startsWith('http') ? image : new URL(image, Astro.site).href)
  : new URL('/og-image.svg', Astro.site).href;
const socialImageAlt = imageAlt || `${siteTitle} preview image`;
const canonicalUrl = canonical
  ? new URL(canonical, Astro.site).href
  : new URL(Astro.url.pathname, Astro.site).href;
const robotsValue = noindex ? 'noindex, nofollow' : 'index, follow';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'High in the FlightSim Sky',
  url: new URL('/', Astro.site).href,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'High in the FlightSim Sky',
  url: new URL('/', Astro.site).href,
  sameAs: ['https://bit.ly/34eNWDP'],
};

const schemas = [
  websiteSchema,
  organizationSchema,
  ...(structuredData
    ? (Array.isArray(structuredData) ? structuredData : [structuredData])
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsValue} />
    <meta name="theme-color" content="#0b1e33" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="High in the FlightSim Sky" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    
    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/high-in-the-flightsim-sky-logo.PNG" />
    
    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Feed" href="/feed.xml" />
    
    <!-- Preload fonts for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    
    <!-- Generator -->
    <meta name="generator" content={Astro.generator} />
    
    <!-- Anti-flash: apply saved theme before paint -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || (!saved && window.matchMedia('(prefers-color-scheme: light)').matches)) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>

    <script is:inline>
      (function() {
        const pathname = window.location.pathname.replace(/\/+$/, '') || '/';
        if (pathname !== '/videos' && pathname !== '/posts') return;

        const params = new URLSearchParams(window.location.search);
        const tag = params.get('tag')?.trim();
        if (!tag) return;

        history.replaceState(
          null,
          '',
          `${window.location.pathname}#tag=${encodeURIComponent(tag)}`
        );
      })();
    </script>
    
    <title>{siteTitle}</title>
  </head>
  <body>
    <LiveBanner />
    <Navigation />
    
    <main>
      <slot />
    </main>
    
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-content">
          <div class="footer-section">
            <a class="footer-brand" href="/">
              <img src="/high-in-the-flightsim-sky-logo.PNG" alt="" width="48" height="48" />
              <span>High in the FlightSim Sky</span>
            </a>
            <p>A flight sim video archive with community posts and search.</p>
          </div>
          <div class="footer-section">
            <h4>Navigation</h4>
            <ul>
              <li><a href="/">Home</a></li>
              <li><a href="/videos/">Videos</a></li>
              <li><a href="/posts">Community</a></li>
              <li><a href="/feed">Feed</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
          <div class="footer-section">
            <h4>Resources</h4>
            <ul>
              <li><a href="/feed.xml">RSS Feed</a></li>
              <li><a href="/sitemap.xml">Sitemap</a></li>
              <li><a href="https://github.com/highinthefssky/highinthefssky.github.io">GitHub</a></li>
              <li><a href="https://bit.ly/34eNWDP" target="_blank" rel="noopener noreferrer">YouTube Channel</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2024 High in the FlightSim Sky. All rights reserved.</p>
          <p><a href="/privacy">Privacy</a> | <a href="/terms">Terms</a> | <a href="/contact">Contact</a></p>
        </div>
      </div>
    </footer>
    <BackToTop />
  </body>
</html>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    padding: 0;
    font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: radial-gradient(circle at 20% 20%, var(--bg-radial1), transparent 35%),
      radial-gradient(circle at 80% 0%, var(--bg-radial2), transparent 30%),
      linear-gradient(135deg, var(--bg-body-from) 0%, var(--bg-body-via) 55%, var(--bg-body-to) 100%);
    color: var(--text-primary);
    transition: background 0.3s ease, color 0.3s ease;
  }

  main {
    min-height: calc(100vh - 200px);
  }

  .footer {
    background: var(--bg-elevated);
    backdrop-filter: blur(10px);
    color: var(--text-primary);
    border-top: 1px solid var(--footer-border);
    padding: 3rem 1rem;
    margin-top: 4rem;
    box-shadow: inset 0 1px 0 var(--footer-border);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--footer-border);
  }

  .footer-section h3,
  .footer-section h4 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-heading);
    font-size: 1.125rem;
    font-weight: 600;
    text-decoration: none;
  }

  .footer-brand img {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-section p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .footer-section ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-section li {
    margin-bottom: 0.5rem;
  }

  .footer-section a {
    color: var(--footer-link);
    text-decoration: none;
    transition: color 0.2s ease, text-shadow 0.2s ease;
  }

  .footer-section a:hover {
    color: var(--accent);
    text-shadow: 0 0 8px rgba(125, 211, 252, 0.4);
  }

  .footer-bottom {
    border-top: 1px solid var(--footer-bottom-border);
    padding-top: 2rem;
    text-align: center;
    color: var(--footer-muted);
  }

  .footer-bottom p {
    margin: 0.5rem 0;
  }

  .footer-bottom a {
    color: var(--footer-muted);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-bottom a:hover {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .footer {
      padding: 2rem 1rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
